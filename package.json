{
  "name": "gga-vitality-reserve",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:upstream": "node --test tests/upstream.mjs",
    "test:setup": "node tools/test-sources.mjs",
    "format": "prettier --write .",
