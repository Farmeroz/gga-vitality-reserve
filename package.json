    "build": "node tools/build.mjs",
    "check": "npm run format:check && npm test && npm run test:upstream && npm run build"
  },
  "devDependencies": {
    "fflate": "0.8.2",
    "linkedom": "^0.18.12",
    "prettier": "3.9.6"
  },
  "engines": {
    "node": ">=22"
  }
}
